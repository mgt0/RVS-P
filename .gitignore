__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.DS_Store
.claude/
.vscode/

# 수집된 데이터는 버전관리 대상이 아니다 (용량 + 바이너리)
lerobot_data/episodes/
lerobot_data/classification/

# 카메라 식별 썸네일 등 임시 산출물
scratch/

# 학습 체크포인트 (lerobot-train 산출물 + rollout이 읽는 체크포인트, 어느 경로든 포함)
checkpoints/

# CAD 기준 모델은 각자 넣는다(용량 + 바이너리)
lerobot_data/models/

# 배경 참조 이미지는 리그·조명마다 다르다(코드가 아니라 현장 데이터)
lerobot_data/background/

# 펌웨어 빌드 산출물 (arduino-cli --export-binaries). 소스만 버전관리한다.
firmware/*/build/

# 서버 로그 (logs/server.log). 내용은 런타임 기록이라 버전관리하지 않는다.
logs/
